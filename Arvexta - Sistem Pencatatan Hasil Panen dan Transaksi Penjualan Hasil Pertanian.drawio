        <mxCell id="6qwJRlnu5SYjuSiPYtoO-32" connectable="0" parent="6qwJRlnu5SYjuSiPYtoO-31" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];inheritText=1;" value="&amp;nbsp;Ya&amp;nbsp;" vertex="1">
